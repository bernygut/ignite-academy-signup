# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# --- Vite / Frontend ---
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase Edge Function secrets ---
# Set these via: Supabase Dashboard → Edge Functions → send-confirmation → Secrets
# (These are NOT read from this file — they live in Supabase only)
#
# RESEND_API_KEY=re_...           (from resend.com → API Keys)
# FROM_EMAIL=noreply@ignite-academy.org
# ADMIN_NOTIFICATION_EMAIL=admin@ignite-academy.org
